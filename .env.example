# Database Configuration
# compose.yaml reads DATABASE_USER/DATABASE_PW/POSTGRES_DB to provision the
# container, so the database name inside DATABASE_URL must match POSTGRES_DB.
DATABASE_URL=jdbc:postgresql://localhost:5432/website
DATABASE_USER=website
DATABASE_PW=website
POSTGRES_DB=website
#POSTGRES_PORT=5432

# Application Security
APPLICATION_USER=your_admin_username
APPLICATION_PW=your_admin_password

# OpenAI
# Optional. Leave it empty and the site starts with the curator switched off —
# /public/chat shows a notice instead of an input box, and RAG sync and mini app
# metadata generation stay idle. Everything else works unchanged.
OPENAI_API_KEY=

# Tavily Search (for MCP web search tool)
TAVILY_API_KEY=your_tavily_api_key

# MaxMind GeoLite2 City (country and city statistics)
# Only needed to download the database at image build time, never at runtime.
MAXMIND_LICENCE_KEY=your_maxmind_licence_key
# Runtime location of the mmdb file; leave unset to use the image default
# (/app/geoip/GeoLite2-City.mmdb). A missing file leaves geo fields null.
#GEOIP_DATABASE_PATH=/app/geoip/GeoLite2-City.mmdb

# S3/MinIO Storage Configuration
# compose.yaml also uses S3_ACCESS_KEY/S3_SECRET_KEY as the MinIO root
# credentials, so the secret must be at least 8 characters.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=personal-website-files
# Public URL for reading uploaded files. Locally this is the MinIO bucket
# itself; in production point it at your own domain.
S3_PUBLIC_URL=http://localhost:9000/personal-website-files
#S3_CONSOLE_PORT=9001
