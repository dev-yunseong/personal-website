# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/website
DATABASE_USER=your_database_user
DATABASE_PW=your_database_password

# Application Security
APPLICATION_USER=your_admin_username
APPLICATION_PW=your_admin_password

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Tavily Search (for MCP web search tool)
TAVILY_API_KEY=your_tavily_api_key

# S3/MinIO Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=personal-website-files
# Public URL for accessing uploaded files (use your domain or public IP)
S3_PUBLIC_URL=https://your-domain.com
