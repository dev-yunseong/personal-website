#!/bin/sh
# 공개 메모 조회와 관리자 승인 전 초안 관리를 제공한다.

set -eu

WEBSITE_URL="${WEBSITE_URL:-https://yunseong.dev}"
MEMO_API="${WEBSITE_URL}/api/public/memos"
NAV_API="$MEMO_API"
if [ -n "${DRAFT_TOKEN:-}" ]; then NAV_API="${WEBSITE_URL}/api/agent/drafts/memos"; fi
# Preserve logical memo paths when Git Bash launches native curl.
MSYS2_ARG_CONV_EXCL="${MSYS2_ARG_CONV_EXCL:+$MSYS2_ARG_CONV_EXCL;}source=;target=;path=;category="
export MSYS2_ARG_CONV_EXCL

usage() {
    cat >&2 <<'EOF'
usage:
  website memo tree [path]
  website memo list [--category <path>] [--updated-after <yyyy-MM-ddTHH:mm:ss>] [--page <n>] [--limit <1-100>]
  website memo read <id>
  website memo read <id|target-path> --draft
  website memo draft <target-path> <markdown-file|->
  website memo draft-rename <source-path> <target-path>
  website memo draft-upload <image-file>
  website project report <project-id> <json-file|->
  website skills install [skills-directory]

env:
  WEBSITE_URL  defaults to https://yunseong.dev
  BRIEFING_TOKEN  authorizes private project reports (same token as briefing intake)
  DRAFT_TOKEN  enables draft navigation, reads, submission, rename and image upload; cannot publish
EOF
    exit 2
}

is_unsigned_integer() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

encode_form_value() {
    # Windows curl의 인자 문자셋 변환 전에 UTF-8 바이트를 ASCII 폼 값으로 인코딩한다.
    printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n' | sed 's/../%&/g'
}

request() {
    output=$(mktemp)
    trap 'rm -f "$output"' 0 1 2 3 15

    if status=$(curl -sS \
            --connect-timeout 5 \
            --max-time 30 \
            -o "$output" \
            -w '%{http_code}' \
            "$@"); then
        :
    else
        code=$?
        rm -f "$output"
        trap - 0 1 2 3 15
        return "$code"
    fi

    case "$status" in
        2*)
            cat "$output"
            ;;
        *)
            cat "$output" >&2
            printf 'request failed with HTTP %s\n' "$status" >&2
            rm -f "$output"
            trap - 0 1 2 3 15
            return 1
            ;;
    esac

    rm -f "$output"
    trap - 0 1 2 3 15
}

navigation_request() {
    if [ -n "${DRAFT_TOKEN:-}" ]; then
        request --header "X-Draft-Token: $DRAFT_TOKEN" "$@"
    else
        request "$@"
    fi
}

install_project_skill() {
    script_directory=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
    skill_source="$script_directory/../skills/website-project-report/SKILL.md"
    example_source="$script_directory/../docs/examples/project-report.json"
    if [ -f "$script_directory/../SKILL.md" ]; then
        skill_source="$script_directory/../SKILL.md"
        example_source="$script_directory/../assets/project-report.json"
    fi
    [ -r "$skill_source" ] && [ -r "$example_source" ] || {
        printf 'Skill source files are missing\n' >&2
        exit 1
    }

    mkdir -p -- "$1"
    skills_directory=$(CDPATH= cd -P -- "$1" && pwd)
    skill_target="$skills_directory/website-project-report"
    if ! mkdir -- "$skill_target"; then
        printf 'Cannot create skill destination; existing files will not be overwritten: %s\n' "$skill_target" >&2
        exit 1
    fi
    # 이번 명령에서 만든 디렉터리만 실패 시 정리한다.
    trap 'rm -rf -- "$skill_target"' 0
    trap 'exit 1' 1 2 3 15
    mkdir -- "$skill_target/scripts" "$skill_target/assets"
    cp -- "$skill_source" "$skill_target/SKILL.md"
    cp -- "$0" "$skill_target/scripts/website"
    chmod +x "$skill_target/scripts/website"
    cp -- "$example_source" "$skill_target/assets/project-report.json"
    trap - 0 1 2 3 15
    printf 'Installed skill: %s\n' "$skill_target"
}

[ $# -ge 2 ] || usage
resource="$1"
command="$2"
shift 2

if [ "$resource" = "skills" ]; then
    [ "$command" = "install" ] && [ $# -le 1 ] || usage
    [ $# -eq 0 ] || [ -n "$1" ] || usage
    install_project_skill "${1-.agents/skills}"
    exit 0
fi

if [ "$resource" = "project" ]; then
    [ "$command" = "report" ] && [ $# -eq 2 ] || usage
    project_id="$1"
    case "$project_id" in
        ''|*[!a-z0-9-]*|-*) printf 'Invalid project ID\n' >&2; exit 2 ;;
    esac
    [ "${#project_id}" -le 64 ] || usage
    [ -n "${BRIEFING_TOKEN:-}" ] || { printf 'BRIEFING_TOKEN is required\n' >&2; exit 2; }
    [ "$2" = "-" ] || [ -r "$2" ] || { printf 'Cannot read report file\n' >&2; exit 2; }
    request --url "${WEBSITE_URL}/api/agent/projects/$project_id" \
        --request PUT --header "X-Briefing-Token: $BRIEFING_TOKEN" \
        --header 'Content-Type: application/json' --data-binary "@$2"
    exit 0
fi

[ "$resource" = "memo" ] || usage

case "$command" in
    draft-rename)
        [ $# -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || usage
        [ -n "${DRAFT_TOKEN:-}" ] || { printf 'DRAFT_TOKEN is required\n' >&2; exit 2; }
        request --url "${WEBSITE_URL}/api/agent/drafts/rename" \
            --header "X-Draft-Token: $DRAFT_TOKEN" \
            --header 'Content-Type: application/x-www-form-urlencoded; charset=UTF-8' \
            --data "source=$(encode_form_value "$1")&target=$(encode_form_value "$2")"
        ;;
    draft-upload)
        [ $# -eq 1 ] || usage
        [ -n "${DRAFT_TOKEN:-}" ] || { printf 'DRAFT_TOKEN is required\n' >&2; exit 2; }
        [ -f "$1" ] && [ -r "$1" ] && [ -s "$1" ] || { printf 'Cannot read image file\n' >&2; exit 2; }
        extension=$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')
        case "$extension" in
            png) mime=image/png ;;
            jpg|jpeg) mime=image/jpeg ;;
            gif) mime=image/gif ;;
            webp) mime=image/webp ;;
            *) printf 'Supported images: PNG, JPEG, GIF, WebP\n' >&2; exit 2 ;;
        esac
        request --url "${WEBSITE_URL}/api/agent/drafts/images" \
            --header "X-Draft-Token: $DRAFT_TOKEN" \
            --form "file=@-;filename=image.$extension;type=$mime" < "$1"
        ;;
    tree)
        [ $# -le 1 ] || usage
        tree_path="${1:-/}"
        [ $# -eq 0 ] || [ -n "$1" ] || usage
        tree_api="${MEMO_API}/tree"
        if [ -n "${DRAFT_TOKEN:-}" ]; then tree_api="${WEBSITE_URL}/api/agent/drafts/tree"; fi
        navigation_request --url "$tree_api" --get --data-urlencode "path=$tree_path"
        ;;
    draft)
        [ $# -eq 2 ] || usage
        [ -n "$1" ] || usage
        [ -n "${DRAFT_TOKEN:-}" ] || { printf 'DRAFT_TOKEN is required\n' >&2; exit 2; }
        [ "$2" = "-" ] || [ -r "$2" ] || { printf 'Cannot read markdown file\n' >&2; exit 2; }
        request --url "${WEBSITE_URL}/api/agent/drafts" \
            --header "X-Draft-Token: $DRAFT_TOKEN" \
            --header 'Content-Type: application/x-www-form-urlencoded; charset=UTF-8' \
            --data-urlencode "target=$1" --data-urlencode "content@$2"
        ;;
    list)
        category=""
        updated_after=""
        page=""
        limit=""

        while [ $# -gt 0 ]; do
            option="$1"
            [ $# -ge 2 ] || usage
            value="$2"
            case "$option" in
                --category)
                    [ -z "$category" ] && [ -n "$value" ] || usage
                    category="$value"
                    ;;
                --updated-after)
                    [ -z "$updated_after" ] || usage
                    [ -n "$value" ] || usage
                    updated_after="$value"
                    ;;
                --page)
                    [ -z "$page" ] || usage
                    is_unsigned_integer "$value" || usage
                    page="$value"
                    ;;
                --limit)
                    [ -z "$limit" ] || usage
                    is_unsigned_integer "$value" || usage
                    [ "$value" -ge 1 ] && [ "$value" -le 100 ] || usage
                    limit="$value"
                    ;;
                *) usage ;;
            esac
            shift 2
        done

        set -- --url "$NAV_API" --get
        if [ -n "$category" ]; then
            set -- "$@" --data-urlencode "category=$category"
        fi
        if [ -n "$updated_after" ]; then
            set -- "$@" --data-urlencode "updatedAfter=$updated_after"
        fi
        if [ -n "$page" ]; then
            set -- "$@" --data-urlencode "page=$page"
        fi
        if [ -n "$limit" ]; then
            set -- "$@" --data-urlencode "limit=$limit"
        fi
        navigation_request "$@"
        ;;
    read)
        if [ $# -eq 2 ]; then
            [ "$2" = "--draft" ] && [ -n "$1" ] || usage
            [ -n "${DRAFT_TOKEN:-}" ] || { printf 'DRAFT_TOKEN is required\n' >&2; exit 2; }
            if is_unsigned_integer "$1"; then
                [ "$1" -gt 0 ] || usage
                selector="memoId=$1"
            else
                selector="target=$1"
            fi
            navigation_request --url "${WEBSITE_URL}/api/agent/drafts/content" --get --data-urlencode "$selector"
            exit
        fi
        [ $# -eq 1 ] || usage
        is_unsigned_integer "$1" || usage
        [ "$1" -gt 0 ] || usage
        request --url "${MEMO_API}/$1/content"
        ;;
    *)
        usage
        ;;
esac
