[Unit]
Description=Personal website operations dashboard runner
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yunseong/dev/personal-website
Environment=WEBSITE_URL=https://yunseong.dev
EnvironmentFile=/home/yunseong/deploy/server-dashboard/runner.env
ExecStart=/usr/bin/python3 /home/yunseong/dev/personal-website/bin/operations-runner.py --config /home/yunseong/deploy/server-dashboard/dashboard.yml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
